{
  "name": "botlake",
  "private": true,
  "workspaces": [
    ".botlake",
    "packages/*",
    "spools/*",
    "plugins/*"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "build:cli": "mkdir -p out && cd cli && go build -o ../out/botlake ./cmd/botlake && go build -o ../out/bl ./cmd/bl",
    "install:local": "bun run build:cli && mkdir -p \"$HOME/.local/bin\" && install -m 755 out/botlake out/bl \"$HOME/.local/bin/\"",
    "test": "bun test tests/blackbox",
    "check:go": "cd cli && go vet ./..."
  },
  "devDependencies": {
    "@botlake/core": "workspace:*",
    "@botlake/spool-batteries": "workspace:*",
    "@botlake/spool-cron": "workspace:*",
    "@botlake/spool-flags": "workspace:*",
    "@botlake/spool-harnesses": "workspace:*",
    "@botlake/spool-identity": "workspace:*",
    "@botlake/spool-kanban": "workspace:*",
    "@types/bun": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "*.{ts,mts,cts,js,mjs,cjs}": [
      "oxlint --fix --deny-warnings",
      "oxfmt --write"
    ],
    "*.{json,jsonc,json5,md,markdown,mdx,yml,yaml,toml}": "oxfmt --write"
  },
  "packageManager": "bun@1.4.2"
}
