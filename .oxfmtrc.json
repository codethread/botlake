{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "proseWrap": "never",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["node_modules/", "dist/", "out/", "coverage/", "bun.lock"]
}
