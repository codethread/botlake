{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error"
  },
  "rules": {
    "eqeqeq": ["error", "always"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-type-assertion": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/only-throw-error": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": false,
        "allowNumber": false,
        "allowNullableObject": false
      }
    ],
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/prefer-nullish-coalescing": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/no-await-in-loop": "off",
    "oxc/no-map-spread": "off",
    "eslint/no-inner-declarations": "off",
    "eslint/max-lines-per-function": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/consistent-return": "off",
    "eslint/require-await": "off",
    "typescript/require-await": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/require-post-message-target-origin": "off",
    "promise/always-return": "off",
    "eslint/max-lines": "off"
  },
  "ignorePatterns": ["node_modules/", "dist/", "out/", "coverage/"],
  "overrides": [
    {
      "files": ["extensions/*/src/**/*.{ts,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../**"],
                "message": "Use a declared package dependency and its public exports, not a relative import across package boundaries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/core/src/**/*.{ts,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../../**"],
                "message": "Use a declared package dependency and its public exports, not a relative import across package boundaries."
              },
              {
                "group": ["@botlake/extension-*", "@botlake/identity"],
                "message": "Core must not depend on extensions or native plugins. Load explicitly selected extensions through workspace configuration."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["plugins/*/*.{ts,mts,cts,js,mjs,cjs}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "Use a declared package dependency and its public exports, not a relative import across package boundaries."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["tests/blackbox/**/*.ts"],
      "rules": {
        "import/max-dependencies": "off"
      }
    }
  ]
}
