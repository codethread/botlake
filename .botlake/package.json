{
  "name": "@botlake/dogfood",
  "private": true,
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@botlake/core": "latest",
    "@botlake/extension-agents": "latest",
    "@botlake/extension-batteries": "latest",
    "@botlake/extension-cron": "latest",
    "@botlake/extension-ct-config": "latest",
    "@botlake/extension-diary": "latest",
    "@botlake/extension-flags": "latest",
    "@botlake/extension-identity": "latest",
    "@botlake/extension-references": "latest",
    "@botlake/extension-ui": "latest",
    "@botlake/extension-work": "latest",
    "@botlake/extension-work-agents": "latest",
    "@botlake/extension-work-auto-bot": "latest",
    "@botlake/extension-workflow": "latest",
    "@botlake/native-session": "latest",
    "xstate": "5.33.3",
    "zod": "^4.6.7"
  },
  "botlake": {
    "name": "botlake",
    "extensions": [
      "@botlake/extension-batteries",
      "@botlake/extension-identity",
      "@botlake/extension-diary",
      "./.botlake/src/flags.ts",
      "./.botlake/src/references.ts",
      "./.botlake/src/agents.ts",
      "./.botlake/src/priming.ts",
      "./.botlake/src/work.ts",
      "./.botlake/src/work-agents.ts",
      "./.botlake/src/work-auto-bot.ts",
      "./.botlake/src/workflow.ts",
      "@botlake/extension-cron",
      "@botlake/extension-ui"
    ],
    "minimumCore": "0.2.0"
  },
  "patchedDependencies": {
    "xstate@5.33.3": "../patches/xstate@5.33.3.patch"
  }
}
